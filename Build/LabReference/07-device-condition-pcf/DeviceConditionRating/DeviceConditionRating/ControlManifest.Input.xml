<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="EquipmentProvisioning" constructor="DeviceConditionRating" version="0.0.1" display-name-key="Device Condition Rating (Lab 07)" description-key="Renders and edits the device condition rating." control-type="standard" >
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- property node identifies a specific, configurable piece of data that the control expects from Dataverse -->
    <property name="rating" display-name-key="Rating" description-key="The device condition rating, from 1 to 5." of-type="Whole.None" usage="bound" required="true" />
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/DeviceConditionRating.css" order="1" />
    </resources>
  </control>
</manifest>
