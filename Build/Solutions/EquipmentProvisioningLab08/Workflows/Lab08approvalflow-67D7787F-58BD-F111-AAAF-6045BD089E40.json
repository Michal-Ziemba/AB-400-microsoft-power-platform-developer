{
  "properties": {
    "connectionReferences": {
      "shared_commondataserviceforapps": {
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "eqp_lab08dataverse_parent"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        }
      },
      "triggers": {
        "When_a_request_is_modified": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "connectionName": "shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger"
            },
            "parameters": {
              "subscriptionRequest/message": 3,
              "subscriptionRequest/entityname": "eqp_request",
              "subscriptionRequest/scope": 4
            },
            "authentication": "@parameters('$authentication')"
          }
        }
      },
      "actions": {
        "Is_newly_approved": {
          "runAfter": {},
          "type": "If",
          "expression": {
            "and": [
              {
                "equals": [
                  "@triggerOutputs()?['body/eqp_requeststatus']",
                  100000001
                ]
              },
              {
                "equals": [
                  "@triggerOutputs()?['body/eqp_availability']",
                  100000000
                ]
              }
            ]
          },
          "actions": {
            "Check_availability": {
              "runAfter": {},
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "PerformUnboundAction"
                },
                "parameters": {
                  "actionName": "eqp_CheckAvailability",
                  "item/RequestId": "@triggerOutputs()?['body/eqp_requestid']"
                },
                "authentication": "@parameters('$authentication')",
                "retryPolicy": {
                  "type": "none"
                }
              }
            },
            "Record_availability": {
              "runAfter": {
                "Check_availability": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord"
                },
                "parameters": {
                  "entityName": "eqp_requests",
                  "recordId": "@triggerOutputs()?['body/eqp_requestid']",
                  "item/eqp_availability": "@if(equals(outputs('Check_availability')?['body/IsAvailable'], true), 100000001, 100000002)",
                  "item/eqp_availabilitycheckedon": "@utcNow()"
                },
                "authentication": "@parameters('$authentication')"
              }
            },
            "Start_fulfilment": {
              "runAfter": {
                "Record_availability": [
                  "Succeeded"
                ]
              },
              "type": "OpenApiConnection",
              "inputs": {
                "host": {
                  "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                  "connectionName": "shared_commondataserviceforapps",
                  "operationId": "UpdateRecord"
                },
                "parameters": {
                  "entityName": "eqp_requests",
                  "recordId": "@triggerOutputs()?['body/eqp_requestid']",
                  "item/eqp_requeststatus": 100000003,
                  "item/eqp_processingnote": "@concat('Fulfilment started on ', utcNow(), '.')"
                },
                "authentication": "@parameters('$authentication')"
              }
            }
          },
          "else": {
            "actions": {}
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}