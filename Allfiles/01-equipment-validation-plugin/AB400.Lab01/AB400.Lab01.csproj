<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>AB400.Lab01</AssemblyName>
    <RootNamespace>AB400.Lab01</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>AB400.Lab01.snk</AssemblyOriginatorKeyFile>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required for every plug-in assembly: the Dataverse SDK types used in Execute. -->
    <PackageReference Include="Microsoft.CrmSdk.CoreAssemblies" Version="9.0.2.*" PrivateAssets="all" />
    <!-- Only needed if your machine doesn't already have the .NET Framework 4.8 targeting pack installed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ServiceModel" />
  </ItemGroup>

</Project>
